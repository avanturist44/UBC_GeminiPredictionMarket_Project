# Copy to .env and fill in. Never commit .env.
# All money in this build is test money. There is no real-money code path.

# --- Needed from Phase 0 ---
# Postgres connection. Local: postgres://localhost:5432/thesis_market
# Supabase: use the pooled "transaction" connection string.
DATABASE_URL=postgres://localhost:5432/thesis_market

# Decided in Phase 0 (see docs/gemini-findings.md): paper | gemini-sandbox
TRADING_MODE=paper
# Global kill switch: false stops all orders, reading still works.
TRADING_ENABLED=true

# Public market data, production host, no key needed.
GEMINI_PUBLIC_BASE=https://api.gemini.com
GEMINI_WS_URL=wss://ws.gemini.com

# --- Only for `pnpm verify:gemini --order` (sandbox key with the Trader role) ---
GEMINI_SANDBOX_API_KEY=
GEMINI_SANDBOX_API_SECRET=

# --- Later phases (names fixed by the build plan) ---
# Signs the guest session cookie. Required when deployed; local development has a fallback.
SESSION_SECRET=
GEMINI_TRADE_BASE=https://api.sandbox.gemini.com
GEMINI_AGENT_KEYS=
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_REDIRECT=
TOKEN_ENC_KEY=
# The language model behind the auditor and the news and fade agents (worker only).
# With no key the auditor runs its phrase screen only and the two agents stay off.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
LLM_EFFORT=medium
# Input plus output tokens allowed per UTC day, across the auditor and the agents.
LLM_DAILY_TOKEN_CAP=2000000
# US dollars of model spend allowed per UTC day, across every model call. Checked before each call.
LLM_DAILY_USD_CAP=25
# The agents search the web on every look, so they use a cheaper model and run sparingly.
LLM_AGENT_MODEL=claude-sonnet-5-5
# The switch for the model-backed agents: news, fade, both (comma-separated) or none.
ENABLED_AGENTS=news
NEWS_INTERVAL_MINUTES=60
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_TREASURY_WALLET_ID=
# The worker sends transactions through this; the web app only reads tip-wallet balances from it.
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
# The TipEscrow contract on Arc testnet. A public address: set it on the web app too, to switch tips on.
ESCROW_ADDRESS=0xd87dcE5Ad5b427aC210ABB77F0F1007d419CBe09
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Created and funded by `pnpm chain:setup`. Worker only. Testnet keys; never commit them.
REGISTRAR_KEY=
RESOLVER_KEY=
# Test USDC sent once to each new user wallet.
WELCOME_USDC=2
QUICKNODE_WEBHOOK_SECRET=
ADMIN_SECRET=
