{
  "manifest_version": 3,
  "name": "convíx",
  "version": "0.2.0",
  "description": "The reasoning behind prediction market bets, under the X posts they are about",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://getconvix.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "constants.js",
        "match.js",
        "card.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/InstrumentSerif-Regular.woff2", "fonts/SourceSerif4-Digits.woff2"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
