{
  "manifest_version": 3,
  "name": "convíx",
  "version": "0.2.1",
  "description": "The reasoning behind prediction market bets, under the X posts they are about",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "convíx",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://getconvix.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "constants.js",
        "match.js",
        "card.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/InstrumentSerif-Regular.woff2", "fonts/SourceSerif4-Digits.woff2"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
